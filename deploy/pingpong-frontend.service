[Unit]
Description=AI 乒乓球教练 - 前端 Web 服务
After=network.target pingpong-backend.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/coachagent/frontend
Environment="NODE_ENV=production"
EnvironmentFile=/opt/coachagent/frontend/.env
ExecStart=/usr/bin/npm run preview  -- --host 0.0.0.0 --port 8501
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pingpong-frontend

[Install]
WantedBy=multi-user.target
